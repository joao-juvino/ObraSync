    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "mensagem": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@obrasync.com"
          },
          "senha": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        }
      },
      "Token": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "example": "Bearer"
          },
          "nome": {
            "type": "string"
          },
          "perfil": {
            "type": "string"
          }
        }
      },
      "VistoriaRequest": {
        "type": "object",
        "required": [
          "obraId",
          "responsavelId",
          "tipo"
        ],
        "properties": {
          "obraId": {
            "type": "integer",
            "format": "int64"
          },
          "responsavelId": {
            "type": "integer",
            "format": "int64"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "ESTRUTURAL",
              "ELETRICA",
              "HIDRAULICA",
              "ALVENARIA",
              "ACABAMENTO",
              "SEGURANCA_TRABALHO"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "APROVADA",
              "PENDENTE",
              "REPROVADA",
              "EM_ANDAMENTO"
            ]
          },
          "dataVistoria": {
            "type": "string",
            "format": "date"
          },
          "localizacao": {
            "type": "string",
            "maxLength": 150
          },
          "observacoes": {
            "type": "string"
          }
        },
        "example": {
          "obraId": 1,
          "responsavelId": 2,
          "tipo": "ELETRICA",
          "status": "PENDENTE",
          "dataVistoria": "2026-09-23",
          "localizacao": "Bloco A"
        }
      },
      "Vistoria": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "obraId": {
            "type": "integer",
            "format": "int64"
          },
          "responsavelId": {
            "type": "integer",
            "format": "int64"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "ESTRUTURAL",
              "ELETRICA",
              "HIDRAULICA",
              "ALVENARIA",
              "ACABAMENTO",
              "SEGURANCA_TRABALHO"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "APROVADA",
              "PENDENTE",
              "REPROVADA",
              "EM_ANDAMENTO"
            ]
          },
          "dataVistoria": {
            "type": "string",
            "format": "date"
          },
          "localizacao": {
            "type": "string",
            "maxLength": 150
          },
          "observacoes": {
            "type": "string"
          },
          "obra": {
            "type": "string"
          },
          "responsavel": {
            "type": "string"
          }
        }
      },
      "Pagina": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vistoria"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Resumo": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "aprovadas": {
            "type": "integer"
          },
          "pendentes": {
            "type": "integer"
          },
          "reprovadas": {
            "type": "integer"
          },
          "emAndamento": {
            "type": "integer"
          },
          "taxaAprovacao": {
            "type": "number"
          }
        }
      },
      "Evidencia": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nomeArquivo": {
            "type": "string"
          },
          "tipoMime": {
            "type": "string"
          },
          "tamanho": {
            "type": "integer"
          },
          "descricao": {
            "type": "string"
          },
          "dataUpload": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
